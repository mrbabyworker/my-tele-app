# Server-only token from BotFather. Required for validating Telegram initData.
TELEGRAM_BOT_TOKEN=

# Public URL of the deployed Mini App, for docs and bot setup scripts.
NEXT_PUBLIC_APP_URL=

# Optional: comma-separated Telegram user IDs that should have local admin access.
TELEGRAM_ADMIN_IDS=

# Optional but recommended: secret passed to Telegram setWebhook as secret_token.
TELEGRAM_WEBHOOK_SECRET=

# Required in production for /busyness persistence. Use Vercel KV or Upstash Redis REST credentials.
KV_REST_API_URL=
KV_REST_API_TOKEN=
# Alternative names are also supported:
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=

# Preferred free-friendly option for /busyness persistence.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
